# 双系统（Ubuntu / Windows）共用同一仓库：统一行尾，避免 CRLF 弄坏 bash 脚本
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.xml  text eol=lf
*.sdf  text eol=lf
*.urdf text eol=lf
*.xacro text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.st   text eol=lf

*.png  binary
*.jpg  binary
*.pdf  binary
*.pptx binary
*.tar  binary
