<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aic_gazebo_sim</name>
  <version>0.1.0</version>
  <description>
    AIC 视觉逻辑算法应用赛仿真场景（Ignition Fortress）：12 库位货架 + 四类缺陷铁片 +
    三轴龙门（XYZ + 末端相机），含控制侧与视觉侧的仿真实现 / ground-truth 桩。
  </description>
  <maintainer email="saber2089467296@163.com">Nileuy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>aic_msgs</exec_depend>
  <exec_depend>aic_behavior_tree</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
