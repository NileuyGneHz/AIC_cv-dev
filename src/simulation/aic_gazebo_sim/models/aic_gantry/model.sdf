<?xml version="1.0" ?>
<!--
  三轴龙门（XYZ 直角坐标 / 单立柱悬臂）—— 对齐 VirtualNext Smart 官方平台外观

  关节链（与官方一致：立柱走 Y、横梁升降 Z、横梁上的滑台走 X）：
    base（底板上的两条 Y 导轨 + Y 电机）
      └─ y_joint（prismatic Y）→ column（立柱 + 顶部 Z 电机）
            └─ z_joint（prismatic Z）→ beam（横梁 + 左端 X 电机）
                  └─ x_joint（prismatic X）→ tool_head（绿色滑台 + 吸盘）

  为什么把 beam / tool_head 的 link 原点都放在世界 x=0：
    控制侧 /aic/joint/x/cmd_pos 直接按世界 x 下发（sim_layout.staging.x=0.30、
    货架列 -0.375..0.375），原点放在 x=0 就不必在控制器里加偏移。
  关节零位：吸盘吸口下沿世界 z = 0.239（= sim_layout.yaml gantry.pad_z0，
    改这里必须同步改那个值），相机在置物台正上方（ee_cam，独立的固定模型）。

  与 ROS 的接口（全部经 ros_gz_bridge，见 launch/sim.launch.py）：
    /aic/joint/{x,y,z}/cmd_pos   std_msgs/Float64 → ignition.msgs.Double（位置指令，m）
  反馈：
    /world/aic_warehouse/model/aic_gantry/joint_state   ignition.msgs.Model → sensor_msgs/JointState
-->
<sdf version="1.6">
  <model name="aic_gantry">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- ============================== base：底板上的 Y 导轨 ============================== -->
    <link name="base">
      <inertial>
        <mass>120.0</mass>
        <inertia>
          <ixx>20</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>20</iyy><iyz>0</iyz><izz>20</izz>
        </inertia>
      </inertial>

      <!-- 两条 Y 向导轨（官方：立柱骑在底板左侧的两条白色导轨上前后走） -->
      <visual name="rail_l">
        <pose>-0.525 0.02 0.045 0 0 0</pose>
        <geometry><box><size>0.030 0.90 0.05</size></box></geometry>
        <material><ambient>0.62 0.64 0.66 1</ambient><diffuse>0.74 0.76 0.78 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular></material>
      </visual>
      <visual name="rail_r">
        <pose>-0.475 0.02 0.045 0 0 0</pose>
        <geometry><box><size>0.030 0.90 0.05</size></box></geometry>
        <material><ambient>0.62 0.64 0.66 1</ambient><diffuse>0.74 0.76 0.78 1</diffuse></material>
      </visual>

      <!-- Y 电机：底座左前侧，电机轴沿 Y（官方：偏左放置，不顶在立柱正下方） -->
      <visual name="motor_y">
        <pose>-0.50 -0.40 0.095 0 0 0</pose>
        <geometry><box><size>0.10 0.11 0.10</size></box></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.14 0.14 0.16 1</diffuse></material>
      </visual>
      <visual name="coupler_y">
        <pose>-0.50 -0.335 0.095 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.30 0.55 0.16 1</ambient><diffuse>0.38 0.68 0.22 1</diffuse></material>
      </visual>

      <collision name="rail_l_col">
        <pose>-0.525 0.02 0.045 0 0 0</pose>
        <geometry><box><size>0.030 0.90 0.05</size></box></geometry>
      </collision>
      <collision name="rail_r_col">
        <pose>-0.475 0.02 0.045 0 0 0</pose>
        <geometry><box><size>0.030 0.90 0.05</size></box></geometry>
      </collision>
    </link>

    <!-- ============================== 立柱（Y 向移动） ============================== -->
    <link name="column">
      <pose>-0.50 0 0 0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.40</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.40</iyy><iyz>0</iyz><izz>0.03</izz>
        </inertia>
      </inertial>

      <!-- 立柱底座滑块：跨在两条导轨上 -->
      <visual name="saddle">
        <pose>0 0.02 0.075 0 0 0</pose>
        <geometry><box><size>0.09 0.14 0.07</size></box></geometry>
        <material><ambient>0.20 0.21 0.23 1</ambient><diffuse>0.26 0.27 0.30 1</diffuse></material>
      </visual>

      <!-- 立柱本体（白色铝型材） -->
      <visual name="post">
        <pose>0 0.02 0.36 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.56</size></box></geometry>
        <material><ambient>0.74 0.76 0.78 1</ambient><diffuse>0.84 0.86 0.88 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular></material>
      </visual>

      <!-- 顶部 Z 电机 + 绿色联轴器（官方：立柱最顶端，轴垂直向下） -->
      <visual name="motor_z">
        <pose>0 0.02 0.705 0 0 0</pose>
        <geometry><box><size>0.075 0.075 0.13</size></box></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.14 0.14 0.16 1</diffuse></material>
      </visual>
      <visual name="coupler_z">
        <pose>0 0.02 0.633 0 0 0</pose>
        <geometry><cylinder><radius>0.030</radius><length>0.026</length></cylinder></geometry>
        <material><ambient>0.30 0.55 0.16 1</ambient><diffuse>0.38 0.68 0.22 1</diffuse></material>
      </visual>

      <collision name="post_col">
        <pose>0 0.02 0.36 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.56</size></box></geometry>
      </collision>
    </link>

    <!-- ============================== 横梁（Z 向升降） ============================== -->
    <link name="beam">
      <pose>0 0 0.545 0 0 0</pose>
      <!-- 关掉重力：Z 是竖直轴，位置控制器是速度伺服，上电初始化阶段会先被重力
           拉到下限再爬回来（实测直接卡在下限）。恢复真实重力时要配制动/前馈。 -->
      <gravity>false</gravity>
      <inertial>
        <mass>6.0</mass>
        <inertia>
          <ixx>0.55</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.20</iyy><iyz>0</iyz><izz>0.55</izz>
        </inertia>
      </inertial>

      <!-- 横梁本体：世界 x -0.51..0.55（左端接立柱，右端悬到货架上方） -->
      <visual name="beam">
        <pose>0.005 0 0 0 0 0</pose>
        <geometry><box><size>1.10 0.055 0.055</size></box></geometry>
        <material><ambient>0.66 0.68 0.70 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular></material>
      </visual>

      <!-- 与立柱的绿色连接座（随横梁上下滑） -->
      <visual name="column_bracket">
        <pose>-0.50 0 0 0 0 0</pose>
        <geometry><box><size>0.10 0.09 0.115</size></box></geometry>
        <material><ambient>0.30 0.55 0.16 1</ambient><diffuse>0.38 0.68 0.22 1</diffuse></material>
      </visual>

      <!-- 横梁左端的 X 电机 + 绿色联轴器（官方：悬空外突） -->
      <visual name="motor_x">
        <pose>-0.60 0 0 0 0 0</pose>
        <geometry><box><size>0.10 0.075 0.075</size></box></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.14 0.14 0.16 1</diffuse></material>
      </visual>
      <visual name="coupler_x">
        <pose>-0.503 0 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.026</radius><length>0.028</length></cylinder></geometry>
        <material><ambient>0.30 0.55 0.16 1</ambient><diffuse>0.38 0.68 0.22 1</diffuse></material>
      </visual>

      <collision name="beam_col">
        <pose>0.005 0 0 0 0 0</pose>
        <geometry><box><size>1.10 0.055 0.055</size></box></geometry>
      </collision>
    </link>

    <!-- ============================== 滑台 + 末端吸盘（X 向移动） ============================== -->
    <link name="tool_head">
      <pose>0 0 0.545 0 0 0</pose>
      <!-- 同上：竖直方向不参与重力，否则会把横梁拽出稳态误差 -->
      <gravity>false</gravity>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.02</iyy><iyz>0</iyz><izz>0.01</izz>
        </inertia>
      </inertial>

      <!-- 绿色滑台 -->
      <visual name="slider">
        <pose>0 0 0.004 0 0 0</pose>
        <geometry><box><size>0.10 0.105 0.075</size></box></geometry>
        <material><ambient>0.30 0.55 0.16 1</ambient><diffuse>0.38 0.68 0.22 1</diffuse></material>
      </visual>

      <!-- Z 向直线导轨（滑台下垂，随滑台一起平移） -->
      <visual name="z_rail">
        <pose>0 0 -0.128 0 0 0</pose>
        <geometry><box><size>0.035 0.035 0.25</size></box></geometry>
        <material><ambient>0.70 0.72 0.74 1</ambient><diffuse>0.80 0.82 0.84 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular></material>
      </visual>

      <!-- 工具法兰 -->
      <visual name="tool_plate">
        <pose>0 0 -0.264 0 0 0</pose>
        <geometry><box><size>0.09 0.07 0.012</size></box></geometry>
        <material><ambient>0.35 0.36 0.38 1</ambient><diffuse>0.42 0.43 0.45 1</diffuse></material>
      </visual>

      <!-- 真空吸盘：波纹管 + 吸口（z_joint=0 时吸口下沿世界 z=0.239 = pad_z0） -->
      <visual name="suction_bellows">
        <pose>0 0 -0.284 0 0 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.040</length></cylinder></geometry>
        <material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.26 0.26 0.28 1</diffuse></material>
      </visual>
      <visual name="suction_pad">
        <pose>0 0 -0.303 0 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.85 0.55 0.10 1</ambient><diffuse>0.92 0.62 0.12 1</diffuse></material>
      </visual>

      <collision name="slider_col">
        <pose>0 0 0.004 0 0 0</pose>
        <geometry><box><size>0.10 0.105 0.075</size></box></geometry>
      </collision>
    </link>

    <!-- ============================== 关节 ============================== -->
    <!-- Y：立柱沿导轨前后走（官方 Y 电机在底座左下） -->
    <joint name="y_joint" type="prismatic">
      <parent>base</parent>
      <child>column</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.24</lower>
          <!-- 上限 0.32：+Y 侧要到分拣货架第 3 层（y=0.31） -->
          <upper>0.32</upper>
          <effort>200</effort>
          <velocity>0.30</velocity>
        </limit>
        <dynamics><damping>15</damping><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <!-- Z：横梁随立柱内的丝杠升降（官方 Z 电机在立柱顶端） -->
    <joint name="z_joint" type="prismatic">
      <parent>column</parent>
      <child>beam</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- 吸盘基准 0.239，最低需求 = 置物台盘顶 0.106 → z=-0.133；
               下限 -0.20 留余量；上限 +0.03 让携料平移跨过第 3 层围边顶 0.232 -->
          <lower>-0.20</lower>
          <upper>0.03</upper>
          <effort>200</effort>
          <velocity>0.15</velocity>
        </limit>
        <dynamics><damping>15</damping><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <!-- X：滑台沿横梁左右移（官方 X 电机在横梁最左端） -->
    <joint name="x_joint" type="prismatic">
      <parent>beam</parent>
      <child>tool_head</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.42</lower>
          <upper>0.45</upper>
          <effort>300</effort>
          <velocity>0.35</velocity>
        </limit>
        <dynamics><damping>20</damping><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <!-- 门架底座固定在世界（否则整体受重力下落） -->
    <joint name="world_fix" type="fixed">
      <parent>world</parent>
      <child>base</child>
    </joint>

    <!-- ============================== 位置控制插件 ============================== -->
    <!-- 关节状态回传：/world/aic_warehouse/model/aic_gantry/joint_state（ignition.msgs.Model） -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>x_joint</joint_name>
      <joint_name>y_joint</joint_name>
      <joint_name>z_joint</joint_name>
    </plugin>

    <!-- 增益 p=1600/d=200：实测 375 mm 阶跃过冲 0.5 mm、约 1.9 s 进 ±1 mm。
         joint_index 是「该关节内部的自由度序号」，三个关节都是单自由度，全填 0；
         写成 0/1/2 时只有 x 能动（踩过）。 -->
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>x_joint</joint_name>
      <joint_index>0</joint_index>
      <initial_position>0.0</initial_position>
      <topic>/aic/joint/x/cmd_pos</topic>
      <p_gain>1600</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>200</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>y_joint</joint_name>
      <joint_index>0</joint_index>
      <initial_position>0.0</initial_position>
      <topic>/aic/joint/y/cmd_pos</topic>
      <p_gain>1600</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>200</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>z_joint</joint_name>
      <joint_index>0</joint_index>
      <initial_position>0.0</initial_position>
      <topic>/aic/joint/z/cmd_pos</topic>
      <p_gain>1600</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>200</d_gain>
    </plugin>
  </model>
</sdf>
