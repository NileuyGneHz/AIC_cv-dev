    <model name="material_11">
      <static>false</static>
      <pose>0.4050 0.0000 -0.0960 0 0 0</pose>
      <link name="disc">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.015e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.015e-05</iyy><iyz>0</iyz><izz>4e-05</izz>
          </inertia>
        </inertial>
        <collision name="disc_col">
          <geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="disc">
          <geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
          <material>
            <ambient>0.42 0.44 0.46 1</ambient>
            <diffuse>0.50 0.52 0.54 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
        <visual name="defect_stain">
          <pose>0.008 0.004 0.00320 0 0 0</pose>
          <geometry><cylinder><radius>0.012</radius><length>0.0006</length></cylinder></geometry>
          <material><ambient>0.16 0.13 0.10 1</ambient><diffuse>0.20 0.16 0.12 1</diffuse></material>
