    <!-- 回收位标记（识别失败物料的去处） -->
    <model name="recycle_marker">
      <static>true</static>
      <link name="mark">
        <visual name="ring">
          <pose>-0.1000 -0.1500 0.0210 0 0 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.55 0.35 0.10 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 末端相机（固定式，置物台正上方朝下；话题 /camera/image 不变） -->
    <model name="ee_cam">
      <static>true</static>
      <pose>0.3000 -0.1500 0.3660 0.0000 1.5708 -1.5708</pose>
      <link name="body">
        <visual name="body">
          <pose>0 0 0.035 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.04</size></box></geometry>
          <material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.20 0.20 0.22 1</diffuse></material>
        </visual>
        <sensor name="camera" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>1</always_on>
          <visualize>false</visualize>
          <update_rate>20.0</update_rate>
          <topic>/camera/image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.005</near><far>4.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- 装饰性相机立柱（货架右前侧；不参与成像） -->
