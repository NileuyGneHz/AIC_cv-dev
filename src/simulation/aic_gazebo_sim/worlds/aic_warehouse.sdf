    <model name="material_12">
      <static>false</static>
      <pose>0.4950 0.0000 -0.0960 0 0 0</pose>
      <link name="disc">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.015e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.015e-05</iyy><iyz>0</iyz><izz>4e-05</izz>
          </inertia>
        </inertial>
        <collision name="disc_col">
          <geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="disc">
          <geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
          <material>
            <ambient>0.42 0.44 0.46 1</ambient>
            <diffuse>0.50 0.52 0.54 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
        <visual name="defect_hole">
          <pose>-0.004 0.012 0.00320 0 0 0</pose>
          <geometry><cylinder><radius>0.0055</radius><length>0.0006</length></cylinder></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

  <!-- 三轴龙门（关节零位 = 吸盘最高位 0.239 / 相机 0.365） -->
  <model name="aic_gantry">
      <static>false</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- ============================== base：固定于世界 ============================== -->
      <link name="base">
        <inertial>
          <mass>120.0</mass>
          <inertia>
            <ixx>20</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>20</iyy><iyz>0</iyz><izz>20</izz>
          </inertia>
        </inertial>

        <!-- 四根立柱（M3：站在整机底板上表面 0.02 上） -->
        <visual name="post_fl">
          <pose>0.50 -0.30 0.32 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.60</size></box></geometry>
          <material><ambient>0.30 0.31 0.33 1</ambient><diffuse>0.34 0.35 0.37 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="post_fr">
          <pose>0.50 0.30 0.32 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.60</size></box></geometry>
          <material><ambient>0.30 0.31 0.33 1</ambient><diffuse>0.34 0.35 0.37 1</diffuse></material>
        </visual>
        <visual name="post_bl">
          <pose>-0.50 -0.30 0.32 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.60</size></box></geometry>
          <material><ambient>0.30 0.31 0.33 1</ambient><diffuse>0.34 0.35 0.37 1</diffuse></material>
        </visual>
        <visual name="post_br">
          <pose>-0.50 0.30 0.32 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.60</size></box></geometry>
          <material><ambient>0.30 0.31 0.33 1</ambient><diffuse>0.34 0.35 0.37 1</diffuse></material>
        </visual>

        <!-- 两条 X 向导轨 -->
        <visual name="rail_front">
          <pose>0 -0.30 0.585 0 0 0</pose>
          <geometry><box><size>1.10 0.05 0.05</size></box></geometry>
          <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular></material>
        </visual>
        <visual name="rail_back">
          <pose>0 0.30 0.585 0 0 0</pose>
          <geometry><box><size>1.10 0.05 0.05</size></box></geometry>
          <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material>
        </visual>

        <collision name="post_fl_col">
          <pose>0.50 -0.30 0.32 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.60</size></box></geometry>
        </collision>
        <collision name="post_fr_col">
          <pose>0.50 0.30 0.32 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.60</size></box></geometry>
        </collision>
        <collision name="post_bl_col">
          <pose>-0.50 -0.30 0.32 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.60</size></box></geometry>
        </collision>
        <collision name="post_br_col">
          <pose>-0.50 0.30 0.32 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.60</size></box></geometry>
        </collision>
      </link>

      <!-- ============================== X 横梁 ============================== -->
      <link name="x_carriage">
        <pose>0 0 0.585 0 0 0</pose>
        <inertial>
          <mass>6.0</mass>
          <inertia>
            <ixx>0.5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.25</iyy><iyz>0</iyz><izz>0.5</izz>
          </inertia>
        </inertial>
        <visual name="beam">
          <geometry><box><size>0.06 0.72 0.06</size></box></geometry>
          <material><ambient>0.45 0.47 0.50 1</ambient><diffuse>0.52 0.54 0.57 1</diffuse></material>
        </visual>
        <visual name="gusset_l">
          <pose>-0.10 0 0.06 0 0 0</pose>
          <geometry><box><size>0.08 0.06 0.06</size></box></geometry>
          <material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.46 0.48 0.51 1</diffuse></material>
        </visual>
        <visual name="gusset_r">
          <pose>0.10 0 0.06 0 0 0</pose>
          <geometry><box><size>0.08 0.06 0.06</size></box></geometry>
          <material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.46 0.48 0.51 1</diffuse></material>
        </visual>
        <collision name="beam_col">
          <geometry><box><size>0.06 0.72 0.06</size></box></geometry>
        </collision>
      </link>

      <!-- ============================== Y 小车 ============================== -->
      <link name="y_carriage">
        <pose>0 0 0.545 0 0 0</pose>
        <inertial>
          <mass>3.0</mass>
          <inertia>
            <ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.02</iyy><iyz>0</iyz><izz>0.02</izz>
          </inertia>
        </inertial>
        <visual name="body">
          <geometry><box><size>0.10 0.10 0.05</size></box></geometry>
          <material><ambient>0.20 0.45 0.65 1</ambient><diffuse>0.24 0.52 0.74 1</diffuse></material>
        </visual>
        <collision name="body_col">
          <geometry><box><size>0.10 0.10 0.05</size></box></geometry>
        </collision>
      </link>

      <!-- ============================== Z 轴 + 末端工具 + 相机 ============================== -->
      <link name="z_carriage">
        <pose>0 0 0.545 0 0 0</pose>
        <!-- 关掉重力：Z 是竖直轴，位置控制器是速度伺服，上电初始化阶段会先被重力
             拉到下限再爬回来（实测直接卡在下限）。仿真阶段不需要 Z 轴的自由落体，
             关掉重力后位置保持完全由控制器负责。恢复真实重力时要配制动/前馈。 -->
        <gravity>false</gravity>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.03</iyy><iyz>0</iyz><izz>0.01</izz>
          </inertia>
        </inertial>

        <!-- Z 向立柱（刻意偏到 -X 侧：让出相机光路，否则相机会埋在立柱实体里） -->
        <visual name="rod">
          <pose>-0.075 0 -0.20 0 0 0</pose>
          <geometry><box><size>0.045 0.045 0.40</size></box></geometry>
          <material><ambient>0.72 0.74 0.76 1</ambient><diffuse>0.80 0.82 0.84 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular></material>
        </visual>

        <!-- 工具支架：两根横条（M3 纯装饰、无碰撞体 —— 相机已改为固定在置物台
             正上方（gen_world.py 生成 ee_cam），吸盘不进光路，无需留中空） -->
        <visual name="flange_bar_a">
          <pose>-0.010 -0.035 -0.275 0 0 0</pose>
          <geometry><box><size>0.10 0.02 0.015</size></box></geometry>
          <material><ambient>0.35 0.36 0.38 1</ambient><diffuse>0.40 0.41 0.43 1</diffuse></material>
        </visual>
        <visual name="flange_bar_b">
          <pose>-0.010 0.035 -0.275 0 0 0</pose>
          <geometry><box><size>0.10 0.02 0.015</size></box></geometry>
          <material><ambient>0.35 0.36 0.38 1</ambient><diffuse>0.40 0.41 0.43 1</diffuse></material>
        </visual>

        <!-- 真空吸盘：波纹管 + 吸口（z_joint=0 时吸口下沿世界 z=0.239，
             即 sim_layout.yaml gantry.pad_z0；改这里必须同步改那个值） -->
        <visual name="suction_bellows">
          <pose>-0.010 0 -0.294 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.022</length></cylinder></geometry>
          <material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.26 0.26 0.28 1</diffuse></material>
        </visual>
        <visual name="suction_pad">
          <pose>-0.010 0 -0.303 0 0 0</pose>
          <geometry><cylinder><radius>0.020</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.85 0.55 0.10 1</ambient><diffuse>0.92 0.62 0.12 1</diffuse></material>
        </visual>

        <!-- M3：相机已移出龙门（固定在置物台正上方，gen_world.py 生成 ee_cam 模型，
             话题仍是 /camera/image），末端只剩吸盘 -->
      </link>

      <!-- ============================== 关节 ============================== -->
      <joint name="x_joint" type="prismatic">
        <parent>base</parent>
        <child>x_carriage</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-0.45</lower>
            <upper>0.45</upper>
            <effort>300</effort>
            <velocity>0.35</velocity>
          </limit>
          <dynamics><damping>20</damping><spring_stiffness>0</spring_stiffness></dynamics>
        </axis>
      </joint>

      <joint name="y_joint" type="prismatic">
        <parent>x_carriage</parent>
        <child>y_carriage</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-0.24</lower>
            <!-- 上限 0.24 -> 0.32：+Y 侧接了分类码放条（sim_layout.yaml place_zones）；
                 横梁半长 0.36，够用，不需要加长横梁 -->
            <upper>0.32</upper>
            <effort>200</effort>
            <velocity>0.30</velocity>
          </limit>
          <dynamics><damping>15</damping><spring_stiffness>0</spring_stiffness></dynamics>
        </axis>
      </joint>

      <joint name="z_joint" type="prismatic">
        <parent>y_carriage</parent>
        <child>z_carriage</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <!-- M3：吸盘基准 0.239，最低需求 = 置物台盘顶 0.106 → z=-0.133；
                 收紧到 -0.20 留余量（M2 的 -0.42 是给旧夹爪几何的） -->
            <!-- M3：上限 +0.03 —— 携料平移时盘底（pad_z0+travel_z-盘厚 = 0.253）
                 必须跨过第 3 层围边顶（0.232）；下限 -0.20 覆盖最低取放位 -->
            <lower>-0.20</lower>
            <upper>0.03</upper>
            <effort>200</effort>
            <velocity>0.15</velocity>
          </limit>
          <dynamics><damping>15</damping><spring_stiffness>0</spring_stiffness></dynamics>
        </axis>
      </joint>

      <!-- 门架底座固定在世界（否则整体受重力下落） -->
      <joint name="world_fix" type="fixed">
        <parent>world</parent>
        <child>base</child>
      </joint>

      <!-- ============================== 位置控制插件 ============================== -->
      <!-- 关节状态回传：/world/aic_warehouse/model/aic_gantry/joint_state（ignition.msgs.Model） -->
      <plugin filename="ignition-gazebo-joint-state-publisher-system"
              name="ignition::gazebo::systems::JointStatePublisher">
        <joint_name>x_joint</joint_name>
        <joint_name>y_joint</joint_name>
        <joint_name>z_joint</joint_name>
      </plugin>

      <!-- 增益：p=20/d=0.6 时（初版）伺服极慢——375 mm 阶跃要 4.8 s 才追上、过冲 17.7 mm、
           8.6 s 才停稳，导致控制侧「剖面走完就报到位」时实际差一格。实测 p=1600/d=200：
           过冲 0.5 mm、约 1.9 s 进 ±1 mm。三轴质量不同（x 6 kg / y 3 kg / z 2 kg），
           统一用这组偏硬的参数对三轴都稳定（z 另有 gravity=false）。 -->
      <!-- joint_index 是「该关节内部的自由度序号」，不是模型里第几个关节：
           三个关节都是单自由度，因此全部填 0。写成 0/1/2 时只有 x 能动，
           y/z 会因为越界静默失效（踩过）。 -->
      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="ignition::gazebo::systems::JointPositionController">
        <joint_name>x_joint</joint_name>
        <joint_index>0</joint_index>
        <initial_position>0.0</initial_position>
        <topic>/aic/joint/x/cmd_pos</topic>
        <p_gain>1600</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>200</d_gain>
      </plugin>

      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="ignition::gazebo::systems::JointPositionController">
        <joint_name>y_joint</joint_name>
        <joint_index>0</joint_index>
        <initial_position>0.0</initial_position>
        <topic>/aic/joint/y/cmd_pos</topic>
        <p_gain>1600</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>200</d_gain>
      </plugin>

      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="ignition::gazebo::systems::JointPositionController">
        <joint_name>z_joint</joint_name>
        <joint_index>0</joint_index>
        <initial_position>0.0</initial_position>
        <topic>/aic/joint/z/cmd_pos</topic>
        <p_gain>1600</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>200</d_gain>
      </plugin>
        <plugin filename="ignition-gazebo-detachable-joint-system"
              name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>z_carriage</parent_link>
        <child_model>material_01</child_model>
        <child_link>disc</child_link>
        <attach_topic>/sim/attach_01</attach_topic>
        <detach_topic>/sim/detach_01</detach_topic>
      </plugin>
      <plugin filename="ignition-gazebo-detachable-joint-system"
              name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>z_carriage</parent_link>
        <child_model>material_02</child_model>
        <child_link>disc</child_link>
        <attach_topic>/sim/attach_02</attach_topic>
        <detach_topic>/sim/detach_02</detach_topic>
      </plugin>
      <plugin filename="ignition-gazebo-detachable-joint-system"
              name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>z_carriage</parent_link>
        <child_model>material_03</child_model>
        <child_link>disc</child_link>
        <attach_topic>/sim/attach_03</attach_topic>
        <detach_topic>/sim/detach_03</detach_topic>
      </plugin>
      <plugin filename="ignition-gazebo-detachable-joint-system"
              name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>z_carriage</parent_link>
        <child_model>material_04</child_model>
        <child_link>disc</child_link>
        <attach_topic>/sim/attach_04</attach_topic>
        <detach_topic>/sim/detach_04</detach_topic>
      </plugin>
      <plugin filename="ignition-gazebo-detachable-joint-system"
              name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>z_carriage</parent_link>
        <child_model>material_05</child_model>
        <child_link>disc</child_link>
        <attach_topic>/sim/attach_05</attach_topic>
        <detach_topic>/sim/detach_05</detach_topic>
      </plugin>
      <plugin filename="ignition-gazebo-detachable-joint-system"
              name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>z_carriage</parent_link>
        <child_model>material_06</child_model>
        <child_link>disc</child_link>
        <attach_topic>/sim/attach_06</attach_topic>
        <detach_topic>/sim/detach_06</detach_topic>
      </plugin>
      <plugin filename="ignition-gazebo-detachable-joint-system"
              name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>z_carriage</parent_link>
        <child_model>material_07</child_model>
