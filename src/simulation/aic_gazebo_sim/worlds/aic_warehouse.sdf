    </model>

    <!-- 自由摄像机：全景默认机位，看板可经 set_pose 服务自由移动 -->
    <model name="scene_cam">
      <static>true</static>
      <pose>0.0000 0.0200 1.6200 0.0000 1.5708 1.5708</pose>
      <link name="body">
        <visual name="body">
          <geometry><box><size>0.09 0.09 0.09</size></box></geometry>
          <material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse></material>
        </visual>
        <sensor name="scene_camera" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <topic>/scene/image</topic>
          <update_rate>15.0</update_rate>
          <always_on>1</always_on>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>20</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
