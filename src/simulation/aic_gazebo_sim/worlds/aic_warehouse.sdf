          <material>
            <ambient>0.42 0.44 0.46 1</ambient>
            <diffuse>0.50 0.52 0.54 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
        <visual name="defect_chip">
          <pose>0.032 -0.020 0.00360 0 0 0</pose>
          <geometry><box><size>0.024 0.022 0.0012</size></box></geometry>
          <material><ambient>0.10 0.11 0.13 1</ambient><diffuse>0.14 0.15 0.17 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="material_09">
      <static>false</static>
      <pose>0.2250 0.0000 -0.0960 0 0 0</pose>
      <link name="disc">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.015e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.015e-05</iyy><iyz>0</iyz><izz>4e-05</izz>
          </inertia>
        </inertial>
        <collision name="disc_col">
          <geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="disc">
          <geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
          <material>
            <ambient>0.42 0.44 0.46 1</ambient>
            <diffuse>0.50 0.52 0.54 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
        <visual name="defect_chip">
          <pose>0.032 -0.020 0.00360 0 0 0</pose>
          <geometry><box><size>0.024 0.022 0.0012</size></box></geometry>
          <material><ambient>0.10 0.11 0.13 1</ambient><diffuse>0.14 0.15 0.17 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="material_10">
      <static>false</static>
      <pose>0.3150 0.0000 -0.0960 0 0 0</pose>
      <link name="disc">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.015e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.015e-05</iyy><iyz>0</iyz><izz>4e-05</izz>
          </inertia>
        </inertial>
        <collision name="disc_col">
          <geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="disc">
          <geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
