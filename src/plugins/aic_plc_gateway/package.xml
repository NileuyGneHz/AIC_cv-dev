<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aic_plc_gateway</name>
  <version>0.1.0</version>
  <description>
    Modbus TCP 从站网关：把 Gazebo 仿真的龙门位置、抓放状态、巡放计数映射成 PLC 寄存器，
    让真实 PLC（或 OpenPLC / ModbusPal 等软 PLC）能读写仿真，用于工业协议联调。

    纯标准库实现 Modbus TCP（MBAP + PDU），不依赖 pymodbus，装机即可跑。
    默认「观察模式」只读不改控制，与决策层可共存；allow_control:=true 才允许 PLC 下发任务。
  </description>
  <maintainer email="saber2089467296@163.com">Nileuy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>aic_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
